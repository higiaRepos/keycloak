    {
      "clientId": "realm-management",
      "name": "${client_realm-management}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false
    }
  ],
  "roles": {
    "client": {
      "realm-management": [
        { "name": "view-realm" },
        { "name": "manage-realm" },
